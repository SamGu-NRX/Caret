<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The host, Contents/MacOS/Caret (dev.caret.host), under the hardened runtime (build-app.sh).

  Granted:
  - com.apple.security.personal-information.calendars: H8. Caret asks for Calendar access the first time the user
    accepts an event card (EventKitCalendars.requestAccess) and reads the user's calendars for the card's line and
    What Caret knows. The hardened runtime refuses Calendar to a process signed without it.

  Evidence: none yet that it is needed, or enough. SIP is disabled on the Mac this was written on, so the hardened
  runtime is not enforced here; the VM run (evidence/host/h8) is the check.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
