<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Caret</string>
	<key>CFBundleIdentifier</key>
	<string>dev.caret.host</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Caret</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Semantic version (major.minor.patch) of every build; a prerelease label such as beta.1 goes only in the DMG and
	     tag names, since macOS reads this key as numbers. CFBundleVersion is the build number build-app.sh writes into
	     the bundle's copy; the 1 here is the value for a build that has none. -->
	<key>CFBundleShortVersionString</key>
	<string>2.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<!-- Set only when LaunchServices opens Caret (Finder, open): the one launch that may register the login agent
	     (LaunchRole). A direct exec or the launchd agent never has it. -->
	<key>LSEnvironment</key>
	<dict>
		<key>CARET_OPENED_BY_LAUNCHSERVICES</key>
		<string>1</string>
	</dict>
	<!-- H12: the commands this build's Caret binary takes, for scripts outside it. D1's uninstall.sh passes
	     the unregister flag only when this lists it: an older build would ignore the flag and start Caret.
	     No double hyphen in this comment: XML forbids it there, and the privacy gate parses this file. -->
	<key>CaretCommands</key>
	<array>
		<string>--unregister</string>
	</array>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- H8: macOS shows this in its Calendar prompt, which Caret raises the first time the user accepts an event card.
	     Full access, not add-only: Caret reads each event back after adding it and before undoing it. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Caret adds the events you accept to your calendar, and reads each one back so it can undo it.</string>
</dict>
</plist>
