{
  "manifest_version": 3,
  "name": "Caret for Chrome",
  "version": "0.1.0",
  "description": "Lets Caret on your Mac read the fields of the form you are in and fill them when you accept. Nothing leaves your Mac from here.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "permissions": ["scripting", "tabs", "webNavigation", "nativeMessaging", "storage"],
  "optional_permissions": ["debugger"]
}
