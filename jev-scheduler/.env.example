# TypeSafe (Jev) API key from https://console.typesafe.ai/keys. Leave empty for a labeled deterministic mock.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Set to 1 to force mock answers (no network) even when a key is present.
JEV_MOCK=
# Optional: URL that receives {run_id, holds, ics} as JSON after scheduling.
SCHEDULE_WEBHOOK_URL=
