{"c":[{"name":"20261009T221421Z-808e29cf46023ffd","text":"Required app exclusions live in CaretScreenCore/ExcludedApps.swift and helper/privacy/read-policy.ts; sc1-exclusions.test.ts checks parity, and DenyList.init/ScreenModel.setAppsOff union user additions without rewriting existing files.","type":"note"},{"name":"20261011T210733Z-f73884678039eb3c","text":"sc1-boundary.test.ts scans fixtures/web-form scripts too: write JSON evidence with writeStoreJson/appendStoreJson (privacy/send.ts); writeStore of JSON.stringify text fails the suite.","type":"note"}]}
